# Parchee Edge backend environment
#
# Copy this file to `backend/.env` for local uvicorn runs.

# Suppress HF symlink warnings on Windows
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Database / encryption
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruralmed
AES_256_KEY=replace_with_base64_32byte_key

# Local Gemma 3 inference through llama.cpp (text only; Whisper handles ASR)
LLAMA_CPP_BASE_URL=http://127.0.0.1:8085
LLAMA_CPP_MODEL_NAME=gemma-3-4b-it
# Optional: set a bearer token to route extraction/summaries through a hosted
# OpenAI-compatible endpoint (Groq, OpenRouter, Gemini, etc.) instead of local.
# Leave empty to keep everything on-device via llama.cpp.
LLAMA_CPP_API_KEY=
LLAMA_CPP_TIMEOUT_SECONDS=90
LLAMA_CPP_MAX_TOKENS=512
LLAMA_CPP_SUMMARY_MAX_TOKENS=384

# Hardware profile: auto, cpu, vulkan, cuda, or custom. Explicit binary paths
# always win, so custom users can supply their own compiled runtimes.
PARCHEE_HARDWARE_PROFILE=auto

# Whisper runtime selected by setup.py. CUDA is selected with the cuda profile;
# Vulkan has no official Windows Whisper binary, so it uses the CPU runtime.
WHISPER_CPP_BINARY=whisper_cpp/runtimes/cpu/whisper-cli.exe
WHISPER_CPP_MODEL=whisper_cpp/models/ggml-base.en.bin
WHISPER_CPP_THREADS=4

# Hybrid streaming endpointing. Values are milliseconds unless stated otherwise.
# Whisper receives an active audio slice every 2 seconds; VAD and punctuation
# decide when accumulated transcript text is sent to the form extractor.
PARCHEE_MIN_RMS=180
PARCHEE_VAD_FRAME_MS=250
PARCHEE_VAD_START_MS=300
PARCHEE_VAD_END_SILENCE_MS=600
PARCHEE_ASR_SLICE_SECONDS=2
PARCHEE_MAX_SPEECH_SECONDS=8
PARCHEE_AUDIO_OVERLAP_MS=300
PARCHEE_MIN_SPEECH_MS=700

# Backend-managed llama-server startup. Choose another compatible GGUF by
# changing the repo/filename before setup, or set MODEL to an existing file.
LLAMA_SERVER_AUTOSTART=true
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8085
LLAMA_SERVER_BINARY=llama_cpp/bin/llama-server.exe
LLAMA_SERVER_MODEL=llama_cpp/models/gemma-3-4b-it-Q4_K_M.gguf
LLAMA_SERVER_DOWNLOAD_MODELS=true
LLAMA_SERVER_MODEL_REPO=unsloth/gemma-3-4b-it-GGUF
LLAMA_SERVER_MODEL_FILENAME=gemma-3-4b-it-Q4_K_M.gguf
# Optional lower-bound safety check: refuse a GGUF larger than this RAM/VRAM
# budget. Leave blank to let llama.cpp perform its own full memory check.
LLAMA_SERVER_MEMORY_BUDGET_GB=
LLAMA_SERVER_CTX_SIZE=4096
LLAMA_SERVER_THREADS=8
LLAMA_SERVER_BATCH_SIZE=2048
LLAMA_SERVER_UBATCH_SIZE=256
LLAMA_SERVER_FLASH_ATTN=true
LLAMA_SERVER_NUMA=true
# 0 = CPU; 999 = all possible layers on the selected GPU runtime.
LLAMA_SERVER_N_GPU_LAYERS=0

# Put additional llama.cpp runtime flags here.
LLAMA_SERVER_EXTRA_ARGS=
