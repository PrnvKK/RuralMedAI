# Parchee Edge backend environment
#
# Copy this file to `backend/.env` for local uvicorn runs.

# Suppress HF symlink warnings on Windows
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Gemini API (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_EXTRACT_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING_LEVEL=low
GEMINI_SUMMARY_MAX_TOKENS=4096
# Optional: hint specialized vocabulary (medical terms, local drug names, etc.)
GEMINI_CUSTOM_VOCABULARY=
# Optional: pin transcription language (e.g. "Hindi"). Empty = auto-detect.
GEMINI_LANGUAGE=

# Database / encryption
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruralmed
AES_256_KEY=replace_with_base64_32byte_key

# Adaptive voice activity detection
PARCHEE_MIN_RMS=180
PARCHEE_VAD_FRAME_MS=250
PARCHEE_VAD_START_MS=300
PARCHEE_VAD_END_SILENCE_MS=900
PARCHEE_MAX_SPEECH_SECONDS=5
PARCHEE_MIN_SPEECH_MS=700

